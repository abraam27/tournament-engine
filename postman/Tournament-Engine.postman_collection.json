    {
      "name": "Tournaments",
      "item": [
        {
          "name": "Seed World Cup 2026",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.tournament && json.tournament.id) {",
                  "        pm.collectionVariables.set('tournamentId', json.tournament.id);",
                  "    }",
                  "    if (json.groups && json.groups.length > 0) {",
                  "        pm.collectionVariables.set('groupId', json.groups[0].groupId);",
                  "    }",
                  "    if (json.groups && json.groups[0] && json.groups[0].teams.length > 0) {",
                  "        pm.collectionVariables.set('teamId', json.groups[0].teams[0].teamId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tournaments/seed/world-cup-2026",
              "host": ["{{baseUrl}}"],
              "path": ["tournaments", "seed", "world-cup-2026"]
            },
            "description": "Seeds FIFA World Cup 2026 from src/data/world-cup-2026-groups.json.\nCreates tournament, 12 groups, 48 teams, and group assignments.\nSafe to re-run: existing records are reused."
          }
        },
        {
          "name": "Create Tournament",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const id = json._id || json.id;",
                  "    if (id) pm.collectionVariables.set('tournamentId', id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"FIFA World Cup 2026\",\n  \"year\": 2026\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tournaments",
              "host": ["{{baseUrl}}"],
              "path": ["tournaments"]
            }
          }
        },
        {
          "name": "Get All Tournaments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tournaments",
              "host": ["{{baseUrl}}"],
              "path": ["tournaments"]
            }
          }
        },
        {
          "name": "Get Tournament By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tournaments/{{tournamentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tournaments", "{{tournamentId}}"]
            }
          }
        },
        {
          "name": "Update Tournament",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"group_stage\",\n  \"teamsCount\": 48,\n  \"groupsCount\": 12,\n  \"teamsPerGroup\": 4,\n  \"qualifiedPerGroup\": 2,\n  \"bestThirdCount\": 8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tournaments/{{tournamentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tournaments", "{{tournamentId}}"]
            }
          }
        },
        {
          "name": "Delete Tournament",
