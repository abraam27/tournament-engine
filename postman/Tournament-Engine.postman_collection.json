          "name": "Create Match",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const id = json._id || json.id;",
                  "    if (id) pm.collectionVariables.set('matchId', id);",
