    {
      "name": "Matches",
      "item": [
        {
          "name": "Generate Group Fixtures",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.matches && json.matches.length > 0) {",
                  "        const match = json.matches[0];",
                  "        const id = match._id || match.id;",
                  "        if (id) pm.collectionVariables.set('matchId', id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/matches/generate/group/{{groupId}}",
              "host": ["{{baseUrl}}"],
              "path": ["matches", "generate", "group", "{{groupId}}"]
            },
            "description": "Generate 6 round-robin group-stage fixtures for one group.\nRequires group to have exactly 4 teams assigned."
          }
        },
        {
          "name": "Generate Tournament Group Stage Fixtures",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.matches && json.matches.length > 0) {",
                  "        const match = json.matches[0];",
                  "        const id = match._id || match.id;",
                  "        if (id) pm.collectionVariables.set('matchId', id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/matches/generate/tournament/{{tournamentId}}/group-stage",
              "host": ["{{baseUrl}}"],
              "path": ["matches", "generate", "tournament", "{{tournamentId}}", "group-stage"]
            },
            "description": "Generate group-stage fixtures for all groups in a tournament.\nSkips groups that already have fixtures."
          }
        },
        {
          "name": "Get Fixtures By Group",
          "event": [
            {
              "listen": "test",
